# Copy this file to .env (for local dev) and set the same variable
# in your Vercel project settings (Settings -> Environment Variables)
# for production.
#
# Vite only exposes env vars to client code if they are prefixed with
# VITE_. Do NOT use REACT_APP_ (that's a Create React App convention).

VITE_API_BASE_URL=http://localhost:8000